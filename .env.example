# Copy to .env and edit. Real environment variables override this file.

# disabled | direct | socks
#   disabled: skip the SMTP step (default; port 25 is blocked on this network)
#   direct:   connect straight to the MX on port 25 (only works if your network allows it)
#   socks:    tunnel through a SOCKS5 proxy, e.g. `ssh -N -D 1080 you@your-vps`
SMTP_TRANSPORT=disabled
SOCKS_PROXY=127.0.0.1:1080

# Hostname sent in EHLO. With a VPS, set this to the VPS's reverse-DNS (PTR) name.
HELO_HOST=localhost
# Envelope sender for MAIL FROM. Empty = null sender "<>". Use an address on a domain you own.
MAIL_FROM=

SMTP_TIMEOUT=10
DNS_TIMEOUT=5
# Seconds between SMTP sessions to the same domain
SMTP_MIN_INTERVAL=4
SMTP_MAX_HOSTS=2

MX_CACHE_TTL=86400
CATCH_ALL_CACHE_TTL=604800

# Total network time for one verification (DNS + all SMTP connects/commands). 0 = no limit.
VERIFY_DEADLINE=20

# --- Phase 2: domain discovery ---
CRAWL_MAX_PAGES=50
CRAWL_MAX_PDFS=10
# Seconds between requests to the same site (robots.txt Crawl-delay is honoured if larger, up to 10s)
CRAWL_DELAY=1.5
HTTP_TIMEOUT=15
CRAWLER_USER_AGENT=JobHuntFinder/0.2 (personal job-search tool; respects robots.txt)
# Optional, free: a GitHub personal access token with no scopes raises the API limit from 60 to 5000 calls/hour.
GITHUB_TOKEN=
GITHUB_MAX_REPOS=8

# --- Phase 3: job search ---
# Optional, free plan: lets saved searches include LinkedIn job listings through Apify
# (actor curious_coder/linkedin-jobs-scraper: public listings only, no LinkedIn login or cookies).
APIFY_TOKEN=
# Results per Apify run (the website and saved searches can lower it; ceiling 100)
APIFY_MAX_RESULTS=25
# Refuse an Apify run that would push this month's usage past this share of the monthly credit
APIFY_BUDGET_FRACTION=0.8
# Used only if Apify doesn't report your monthly limit (free plan = $5)
APIFY_FREE_CREDIT_USD=5
# Seconds between requests to the same job board host
FEED_DELAY=0.5
